# Use Node 20 Alpine for a small, fast image
FROM node:20-alpine

WORKDIR /app

# Copy package.json files
COPY package.json package-lock.json ./

# Install dependencies
RUN npm install

# Copy the rest of the frontend code
COPY . .

# Expose Vite port
EXPOSE 5173

# Start Vite dev server (host flag allows it to be accessed from host machine)
CMD ["npm", "run", "dev", "--", "--host"]